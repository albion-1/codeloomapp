<UserControl x:Class="codeloomapp.Views.UnityExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Expander x:Name="UnityExpander"
              Header="Unity Export"
              IsExpanded="False"
              Margin="0,7,0,0">
        <Border Background="#0D1013"
                BorderBrush="#20262D"
                BorderThickness="1"
                Padding="10"
                Margin="0,5,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="UNITY TARGET"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8994" />
                        <TextBlock x:Name="TargetText"
                                   Text="No Unity project selected"
                                   FontSize="10"
                                   Foreground="#C7CED5"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,12,0" />
                        <TextBlock x:Name="OutputText"
                                   Text="Generated scripts: Assets/CodeLoom/Generated"
                                   FontSize="9"
                                   Foreground="#697580"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,12,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Change Project"
                                Click="ChangeProject_Click"
                                Padding="7,3" />
                        <Button x:Name="OpenFolderButton"
                                Content="Open Generated Folder"
                                Click="OpenFolder_Click"
                                IsEnabled="False"
                                Padding="7,3"
                                Margin="0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="LastExportText"
                           Text="Choose a Unity project, then use Export to Unity from the main toolbar."
                           Foreground="#76818C"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <Border x:Name="ConflictNotice"
                        Visibility="Collapsed"
                        Background="#171313"
                        BorderBrush="#4A3030"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,8,0,0">
                    <TextBlock x:Name="ConflictText"
                               Foreground="#D8A4A4"
                               FontSize="9"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Code Loom owns only this generated folder. If a generated script was edited outside Code Loom, export preserves that edit instead of overwriting it."
                           Foreground="#626D77"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
