<UserControl x:Class="codeloomapp.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Expander x:Name="HistoryExpander"
              Header="History"
              IsExpanded="False"
              Margin="0,7,0,0">
        <Border Background="#0D1013"
                BorderBrush="#20262D"
                BorderThickness="1"
                Padding="10"
                Margin="0,5,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="PROJECT HISTORY"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8994" />
                        <TextBlock x:Name="SummaryText"
                                   Text="No history yet"
                                   FontSize="10"
                                   Foreground="#737E89"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="UndoButton"
                                Content="Undo Project Change"
                                Click="Undo_Click"
                                IsEnabled="False"
                                Padding="7,3" />
                        <Button x:Name="RedoButton"
                                Content="Redo"
                                Click="Redo_Click"
                                IsEnabled="False"
                                Padding="7,3"
                                Margin="0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Ctrl+Z/Ctrl+Y still work normally inside text editors. Outside an editor, they step through project history."
                           FontSize="9"
                           Foreground="#626D77"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <Expander Header="Snapshots"
                          IsExpanded="False"
                          Margin="0,8,0,0">
                    <StackPanel Margin="0,4,0,0">
                        <ListBox x:Name="HistoryList"
                                 MaxHeight="150"
                                 Background="#0F1215"
                                 BorderBrush="#1D2329"
                                 BorderThickness="1"
                                 Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#CCD2D9"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeLabel}"
                                                   Foreground="#697580"
                                                   FontSize="9"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel Margin="0,7,0,0">
                            <TextBlock Text="Up to 40 recent project snapshots are kept locally on this PC."
                                       Foreground="#626D77"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Restore Selected"
                                    Click="RestoreSelected_Click"
                                    Padding="7,3"
                                    Margin="8,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
