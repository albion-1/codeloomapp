<UserControl x:Class="codeloomapp.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CODE FLOW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8A949F" />
                <TextBlock x:Name="SummaryText"
                           Text="Analyzing relationships..."
                           FontSize="11"
                           Foreground="#707B86"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Click="Refresh_Click"
                    Padding="7,3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="EXECUTION PATHS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8A949F"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="EmptyFlowText"
                           Text="No cross-subfile execution path is detectable yet. Add methods that call methods in other subfiles and Code Loom will connect them automatically."
                           Foreground="#707B86"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,2,0,8"
                           Visibility="Collapsed" />

                <ItemsControl x:Name="PathsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F1215"
                                    BorderBrush="#20262D"
                                    BorderThickness="1"
                                    Padding="11"
                                    Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#E8ECF1" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="10"
                                               Foreground="#6F7A85"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,9" />

                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Button Click="Step_Click"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="#171C21"
                                                            BorderBrush="#283039"
                                                            Padding="9,7"
                                                            Margin="0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding KindLabel}"
                                                                       Foreground="#7E8994"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding MethodName}"
                                                                       Foreground="#D9DEE4"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding SubfileName}"
                                                                           Foreground="#CBD1D8"
                                                                           FontSize="11" />
                                                                <TextBlock Foreground="#68737E"
                                                                           FontSize="9">
                                                                    <Run Text="{Binding Role}" />
                                                                    <Run Text="  ·  " />
                                                                    <Run Text="{Binding Section}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <TextBlock Text="{Binding Connector}"
                                                               Foreground="#59646F"
                                                               FontSize="14"
                                                               HorizontalAlignment="Left"
                                                               Margin="30,1,0,1" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="DependencyDetailsExpander"
                          Header="Dependency details"
                          IsExpanded="False"
                          Margin="0,2,0,0">
                    <ItemsControl x:Name="NodesItems" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F1215"
                                        BorderBrush="#20262D"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="0,0,0,7">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#E2E6EB"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Foreground="#6D7883"
                                                           FontSize="9"
                                                           Margin="0,2,0,0">
                                                    <Run Text="{Binding Role}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding Section}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EntryLabel}"
                                                       Foreground="#8FA8BA"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top" />
                                        </Grid>

                                        <TextBlock Text="{Binding Purpose}"
                                                   Foreground="#818B95"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,7" />

                                        <TextBlock FontSize="10" Foreground="#737E89" TextWrapping="Wrap">
                                            <Run Text="Methods: " Foreground="#98A2AC" />
                                            <Run Text="{Binding MethodsText}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="#737E89" TextWrapping="Wrap" Margin="0,3,0,0">
                                            <Run Text="Calls: " Foreground="#98A2AC" />
                                            <Run Text="{Binding CallsText}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="#737E89" TextWrapping="Wrap" Margin="0,3,0,0">
                                            <Run Text="Called by: " Foreground="#98A2AC" />
                                            <Run Text="{Binding CalledByText}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
