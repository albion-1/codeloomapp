<Window x:Class="codeloomapp.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Loom"
        Width="420"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8ECF1" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8ECF1" />
            <Setter Property="Background" Value="#0D1013" />
            <Setter Property="BorderBrush" Value="#2A3139" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="#E8ECF1" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource CodeLoomButtonStyle}">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="78" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTitle" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="PromptDescription" Grid.Row="1" Margin="0,5,0,10" Foreground="#8A949F" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Grid.Row="2" VerticalAlignment="Top" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="OK"
                    IsDefault="True"
                    Click="Ok_Click"
                    Background="#303841"
                    Foreground="#F1F4F7"
                    BorderBrush="#3B4651" />
        </StackPanel>
    </Grid>
</Window>