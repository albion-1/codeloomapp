<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CodeLoom</AssemblyName>
    <RootNamespace>codeloomapp</RootNamespace>
    <Product>Code Loom</Product>
    <Description>A visual C# coding companion that assembles conceptual subfiles into ordinary Unity scripts.</Description>
    <Version>0.1.6</Version>
    <FileVersion>0.1.6.0</FileVersion>
    <AssemblyVersion>0.1.6.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
