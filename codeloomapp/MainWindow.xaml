<Window x:Class="codeloomapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Loom"
        Width="1380"
        Height="860"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D10"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121519" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0F1215" />
        <SolidColorBrush x:Key="BorderBrush" Color="#20262D" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2A3139" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8ECF1" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A949F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#DCE3EA" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1B2026" />
        <SolidColorBrush x:Key="PressedBrush" Color="#242B33" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#161A1F" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#343D47" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0D1013" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="#E8ECF1" />
            <Setter Property="SelectionBrush" Value="#495563" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#14181D" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1013" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1E242B" />
            <Setter Property="RowBackground" Value="#0F1215" />
            <Setter Property="AlternatingRowBackground" Value="#121519" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Code Loom" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Break large source files into understandable pieces, then assemble them back into real C#."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Sign in to GitHub" Click="SignInGitHub_Click" />
                <Button Content="New GitHub Project" Click="CreateGitHubProject_Click" Background="#DCE3EA" Foreground="#0B0D10" BorderBrush="#DCE3EA" />
                <Button Content="Choose Existing Repo" Click="ChooseRepository_Click" />
                <Button Content="Save" Click="SaveProject_Click" />
                <Button Content="Load" Click="LoadProject_Click" />
                <Button Content="Sync" Click="SyncGitHub_Click" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GitHubAccountText" Text="GitHub: not checked" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="RepositoryPathText" Grid.Column="1" Text="No project repository selected" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SaveStateText" Grid.Column="2" Text="Unsaved session" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="3" Content="Refresh Account" Click="RefreshGitHubAccount_Click" Padding="8,4" Margin="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                        <TextBlock Text="PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        <Grid Margin="0,4,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProjectNameText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Rename" Click="RenameProject_Click" Padding="7,4" Margin="6,0,0,0" />
                        </Grid>

                        <WrapPanel>
                            <Button Content="+ Folder" Click="CreateFolder_Click" Padding="8,5" Margin="0,0,5,5" />
                            <Button Content="+ File" Click="CreateFile_Click" Padding="8,5" Margin="0,0,5,5" />
                            <Button Content="Rename" Click="RenameProjectItem_Click" Padding="8,5" Margin="0,0,5,5" />
                            <Button Content="Delete" Click="DeleteProjectItem_Click" Padding="8,5" Margin="0,0,0,5" Foreground="#E7A3A3" />
                        </WrapPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,0" />
                    </StackPanel>

                    <TreeView x:Name="ProjectTree"
                              Margin="7,0,7,7"
                              Loaded="ProjectTree_Loaded"
                              SelectedItemChanged="ProjectTree_SelectedItemChanged" />

                    <ListBox x:Name="FileList" Visibility="Collapsed" SelectionChanged="FileList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <TextBlock Text="SUBFILES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ActiveFileText" Text="No file selected" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListBox x:Name="SubfileList" Margin="8" SelectionChanged="SubfileList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl>
                    <TabItem Header="Subfile">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="SUBFILE NAME" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="SubfileNameBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ROLE" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="RoleBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="C# FRAGMENT" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                                <TextBox x:Name="CodeBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" MinHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="RECEIVES" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="ReceivesBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="RETURNS" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="ReturnsBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="USED BY" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="UsedByBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="PLAIN-ENGLISH PURPOSE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                                <TextBox x:Name="PurposeBox" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Apply Changes" Click="ApplyChanges_Click" Background="#DCE3EA" Foreground="#0B0D10" BorderBrush="#DCE3EA" />
                                    <Button Content="+ New Subfile" Click="NewSubfile_Click" />
                                    <Button Content="Move Up" Click="MoveUp_Click" />
                                    <Button Content="Move Down" Click="MoveDown_Click" />
                                    <Button Content="Delete" Click="DeleteSubfile_Click" Foreground="#E7A3A3" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Variables">
                        <DockPanel Margin="14">
                            <Button DockPanel.Dock="Top" Content="+ Add Variable Definition" HorizontalAlignment="Left" Click="AddVariable_Click" Margin="0,0,0,10" />
                            <DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                                    <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="100" />
                                    <DataGridTextColumn Header="Declared In" Binding="{Binding DeclaredIn}" Width="160" />
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Assembled .cs">
                        <DockPanel Margin="14">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock x:Name="AssembledFileName" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="This is the complete C# file produced from the virtual subfiles." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox x:Name="AssembledCodeBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Flow">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FlowItems" Margin="14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Purpose}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,7" />
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                                    <Run Text="Receives: " /><Run Text="{Binding Receives}" />
                                                    <Run Text="    Returns: " /><Run Text="{Binding Returns}" />
                                                    <Run Text="    Used by: " /><Run Text="{Binding UsedBy}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <Button DockPanel.Dock="Right" Content="Reset Demo" Click="ResetDemo_Click" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>