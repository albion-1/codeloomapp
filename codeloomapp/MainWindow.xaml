<Window x:Class="codeloomapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Loom"
        Width="1380"
        Height="860"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#090B0E">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#11151A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0D1014" />
        <SolidColorBrush x:Key="BorderBrush" Color="#29313B" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#939EAE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E7EDF7" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#181D24" />
            <Setter Property="BorderBrush" Value="#35404E" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#090B0E" />
            <Setter Property="BorderBrush" Value="#303744" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#151A20" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#090B0E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#252C35" />
            <Setter Property="RowBackground" Value="#0D1014" />
            <Setter Property="AlternatingRowBackground" Value="#11151A" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Code Loom" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Break large source files into understandable pieces, then assemble them back into real C#."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Choose Git Repo" Click="ChooseRepository_Click" />
                <Button Content="Save Project" Click="SaveProject_Click" />
                <Button Content="Load Project" Click="LoadProject_Click" />
                <Button Content="Sync GitHub" Click="SyncGitHub_Click" Background="#E7EDF7" Foreground="#090B0E" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#0E1115" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Git repository:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="RepositoryPathText" Grid.Column="1" Text="Not selected"
                           Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SaveStateText" Grid.Column="2" Text="Unsaved session"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <TextBlock Text="PROJECT FILES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Unity-facing scripts" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListBox x:Name="FileList" Margin="8" SelectionChanged="FileList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <TextBlock Text="SUBFILES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ActiveFileText" Text="No file selected" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListBox x:Name="SubfileList" Margin="8" SelectionChanged="SubfileList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <TabControl>
                    <TabItem Header="Subfile">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="SUBFILE NAME" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="SubfileNameBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ROLE" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="RoleBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="C# FRAGMENT" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                                <TextBox x:Name="CodeBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                                         FontSize="13" MinHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="RECEIVES" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="ReceivesBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="RETURNS" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="ReturnsBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="USED BY" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="UsedByBox" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="PLAIN-ENGLISH PURPOSE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                                <TextBox x:Name="PurposeBox" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Apply Changes" Click="ApplyChanges_Click" Background="#E7EDF7" Foreground="#090B0E" />
                                    <Button Content="+ New Subfile" Click="NewSubfile_Click" />
                                    <Button Content="Move Up" Click="MoveUp_Click" />
                                    <Button Content="Move Down" Click="MoveDown_Click" />
                                    <Button Content="Delete" Click="DeleteSubfile_Click" Foreground="#FFB1B1" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Variables">
                        <DockPanel Margin="14">
                            <Button DockPanel.Dock="Top" Content="+ Add Variable Definition" HorizontalAlignment="Left"
                                    Click="AddVariable_Click" Margin="0,0,0,10" />
                            <DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                                    <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="100" />
                                    <DataGridTextColumn Header="Declared In" Binding="{Binding DeclaredIn}" Width="160" />
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Assembled .cs">
                        <DockPanel Margin="14">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock x:Name="AssembledFileName" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="This is the complete C# file produced from the virtual subfiles."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBox x:Name="AssembledCodeBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                                     FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Flow">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FlowItems" Margin="14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1014" BorderBrush="#29313B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Purpose}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,7" />
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                                    <Run Text="Receives: " /><Run Text="{Binding Receives}" />
                                                    <Run Text="    Returns: " /><Run Text="{Binding Returns}" />
                                                    <Run Text="    Used by: " /><Run Text="{Binding UsedBy}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <Button DockPanel.Dock="Right" Content="Reset Demo" Click="ResetDemo_Click" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
