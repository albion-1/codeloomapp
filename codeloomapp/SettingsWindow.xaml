<Window x:Class="codeloomapp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Loom Settings"
        Width="470"
        Height="430"
        MinWidth="430"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0B0D10"
        Foreground="#E8ECF1"
        FontFamily="Segoe UI Variable Text"
        FontWeight="Light">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8ECF1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8ECF1" />
            <Setter Property="Background" Value="#161A1F" />
            <Setter Property="BorderBrush" Value="#2A3139" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#20262C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3A444E" />
                                <Setter Property="Foreground" Value="#F1F4F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#232A31" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3E4852" />
                                <Setter Property="Foreground" Value="#F1F4F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2C353E" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A5561" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8ECF1" />
            <Setter Property="Background" Value="#0D1013" />
            <Setter Property="BorderBrush" Value="#2A3139" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CaretBrush" Value="#E8ECF1" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6DCE2" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#8A949F" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Keep the workstation comfortable without turning it into a wall of controls."
                       Foreground="#7E8994"
                       FontSize="11"
                       Margin="0,3,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Background="#111419"
                    BorderBrush="#20262D"
                    BorderThickness="1"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="EDITOR"
                               Foreground="#7F8994"
                               FontSize="9"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Code font size" FontSize="11" />
                            <TextBlock Text="Applies to subfiles and assembled C#."
                                       Foreground="#68737E"
                                       FontSize="9"
                                       Margin="0,2,12,0" />
                        </StackPanel>
                        <TextBox x:Name="EditorFontSizeBox"
                                 Grid.Column="1"
                                 Text="13"
                                 VerticalContentAlignment="Center" />
                    </Grid>

                    <CheckBox x:Name="WordWrapCheckBox"
                              Content="Wrap long code lines" />
                    <CheckBox x:Name="LineNumbersCheckBox"
                              Content="Show line numbers" />
                </StackPanel>
            </Border>

            <Expander Header="Autosave"
                      IsExpanded="False"
                      Margin="0,10,0,0">
                <Border Background="#0F1215"
                        BorderBrush="#20262D"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Autosave interval" FontSize="11" />
                            <TextBlock Text="Seconds between project-change checks. 2–30 seconds."
                                       Foreground="#68737E"
                                       FontSize="9"
                                       Margin="0,2,12,0" />
                        </StackPanel>
                        <TextBox x:Name="AutosaveSecondsBox"
                                 Grid.Column="1"
                                 Text="3"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                </Border>
            </Expander>

            <TextBlock x:Name="ValidationText"
                       Foreground="#D8A4A4"
                       FontSize="10"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Changes apply immediately after Save."
                       Foreground="#68737E"
                       FontSize="9"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click" />
                <Button Content="Save Settings"
                        Click="Save_Click"
                        Background="#303841"
                        BorderBrush="#3B4651"
                        Foreground="#F1F4F7"
                        Margin="0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
