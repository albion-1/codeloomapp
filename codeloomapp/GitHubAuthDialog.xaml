<Window x:Class="codeloomapp.GitHubAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect GitHub"
        Width="520"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10"
        FontFamily="Segoe UI Variable Text"
        FontWeight="Light">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8ECF1" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource CodeLoomButtonStyle}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F1F4F7" />
            <Setter Property="Background" Value="#0D1013" />
            <Setter Property="BorderBrush" Value="#2A3139" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="#E8ECF1" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Connect GitHub" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Browser sign-in is recommended. If the browser/device-code handoff does not complete cleanly on this PC, you can use a Personal Access Token instead."
                       Foreground="#8D98A3"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#101419"
                BorderBrush="#20262D"
                BorderThickness="1"
                Padding="13"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Browser sign-in" FontWeight="SemiBold" />
                    <TextBlock Text="Opens GitHub's verification flow and then checks the resulting account with the GitHub API."
                               Foreground="#75818C"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Continue in Browser"
                        Click="Browser_Click"
                        Background="#303841"
                        Foreground="#F1F4F7"
                        BorderBrush="#3B4651"
                        Margin="0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Button Grid.Row="2"
                x:Name="ShowTokenButton"
                Content="Use a Personal Access Token instead"
                Click="ShowToken_Click"
                HorizontalAlignment="Left"
                Padding="8,5"
                Margin="0" />

        <Border Grid.Row="3"
                x:Name="TokenPanel"
                Visibility="Collapsed"
                Background="#0F1215"
                BorderBrush="#20262D"
                BorderThickness="1"
                Padding="13"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="PERSONAL ACCESS TOKEN"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#87929D" />
                <PasswordBox x:Name="TokenBox"
                             Margin="0,6,0,0" />
                <TextBlock Text="The token is sent directly to the bundled GitHub CLI through standard input. Code Loom does not save it in project files or settings."
                           Foreground="#6F7A85"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
                <TextBlock Text="For the broadest compatibility with GitHub CLI and private repositories, use a classic Personal Access Token with the permissions required for the repositories you want Code Loom to manage."
                           Foreground="#6F7A85"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,11,0,0">
                    <Button Content="Back"
                            Click="HideToken_Click" />
                    <Button Content="Connect with Token"
                            Click="Token_Click"
                            Background="#303841"
                            Foreground="#F1F4F7"
                            BorderBrush="#3B4651"
                            Margin="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Margin="0" />
        </StackPanel>
    </Grid>
</Window>
