<Window x:Class="codeloomapp.GitHubAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect GitHub"
        Width="620"
        Height="560"
        MinWidth="520"
        MinHeight="430"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10"
        FontFamily="Segoe UI Variable Text"
        FontWeight="Light">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8ECF1" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource CodeLoomButtonStyle}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F1F4F7" />
            <Setter Property="Background" Value="#0D1013" />
            <Setter Property="BorderBrush" Value="#2A3139" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CaretBrush" Value="#E8ECF1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Connect GitHub" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Browser sign-in is recommended. If GitHub's browser/device-code handoff cannot save the account on this PC, use the Personal Access Token fallback."
                       Foreground="#8D98A3"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="#101419"
                        BorderBrush="#20262D"
                        BorderThickness="1"
                        Padding="13"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Browser sign-in" FontWeight="SemiBold" />
                            <TextBlock Text="Opens GitHub's verification flow, verifies the account with the GitHub API, and then connects Git for Pull and Push."
                                       Foreground="#75818C"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Continue in Browser"
                                Click="Browser_Click"
                                Background="#303841"
                                Foreground="#F1F4F7"
                                BorderBrush="#3B4651"
                                Margin="0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Button x:Name="ShowTokenButton"
                        Content="Use a Personal Access Token instead"
                        Click="ShowToken_Click"
                        HorizontalAlignment="Left"
                        Padding="8,5"
                        Margin="0" />

                <Border x:Name="TokenPanel"
                        Visibility="Collapsed"
                        Background="#0F1215"
                        BorderBrush="#20262D"
                        BorderThickness="1"
                        Padding="13"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="PERSONAL ACCESS TOKEN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#87929D" />
                        <PasswordBox x:Name="TokenBox"
                                     Margin="0,6,0,0"
                                     KeyDown="TokenBox_KeyDown" />
                        <TextBlock Text="Press Enter after pasting the token, or use Connect with Token below."
                                   Foreground="#929DA8"
                                   FontSize="10"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="The token is sent directly to the bundled GitHub CLI through standard input. Code Loom never places it in command-line arguments, project files, settings, or diagnostic text."
                                   Foreground="#6F7A85"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="For broad compatibility with private repositories, use a classic Personal Access Token with repo, read:org, and gist scopes. GitHub CLI may store the authenticated credential using Windows credential storage."
                                   Foreground="#6F7A85"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <WrapPanel HorizontalAlignment="Right"
                                   Margin="0,12,0,0">
                            <Button Content="Back"
                                    Click="HideToken_Click" />
                            <Button x:Name="ConnectTokenButton"
                                    Content="Connect with Token"
                                    Click="Token_Click"
                                    Background="#303841"
                                    Foreground="#F1F4F7"
                                    BorderBrush="#3B4651"
                                    Margin="0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="You can resize this window if Windows display scaling makes any content too large."
                       Foreground="#626D77"
                       FontSize="9"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right"
                    Content="Cancel"
                    Click="Cancel_Click"
                    Margin="12,0,0,0" />
        </DockPanel>
    </Grid>
</Window>
